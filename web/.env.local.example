# Copy to .env.local and set values. Never commit .env.local.
# These are the same variables App Hosting needs (see web/apphosting.yaml).

# --- Database (Supabase) ---
# App Hosting secrets: DATABASE_URL, CELGPS_DATABASE_URL
# Append on secrets: ?sslmode=require&uselibpqcompat=true
CELGPS_DB_TARGET=supabase
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres
CELGPS_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres
# Optional password-only fallback (builds pooler URL in code):
# CELGPS_SUPABASE_PASSWORD=YOUR_PASSWORD

# --- TrackSolid Pro OpenAPI ---
# App Hosting secrets: TRACKSOLID_*
TRACKSOLID_ACCOUNT=
TRACKSOLID_PASSWORD_MD5=
TRACKSOLID_APP_KEY=
TRACKSOLID_APP_SECRET=
